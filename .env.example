# OpenRouteService API Key
# Sign up for free at https://openrouteservice.org/dev/#/signup
# Free tier: 2000 directions requests/day, 40 req/min
ORS_API_KEY=

# Google Gemini API Key (place extraction from free-text prompts)
# Create one for free at https://aistudio.google.com/apikey (no credit card)
# IMPORTANT: the free tier lets Google train on prompts. Enable Cloud Billing on
# the project before any public traffic (prompts then count as paid, no training).
GEMINI_API_KEY=

# LLM engine (src/lib/llm). Provider: gemini (default) | anthropic | openai |
# openai-compatible (Groq/Together/OpenRouter via LLM_BASE_URL + LLM_API_KEY).
# Default model is a pinned Gemini Flash-Lite id; never use a "-latest" alias.
# Per-tier overrides: LLM_PROVIDER_T1 / LLM_MODEL_T1 (also T2, T3).
# LLM_PROVIDER=gemini
# LLM_MODEL=
# LLM_FALLBACK_PROVIDER=
# LLM_FALLBACK_MODEL=
# LLM_DAILY_BUDGET_USD=3
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=
# Budget guard (server only): service role key + salt for hashing ips.
# SUPABASE_SERVICE_ROLE_KEY=
# LLM_IP_SALT=

# Contact (email or URL) put in the User-Agent sent to Nominatim/Overpass/Wikipedia
APP_CONTACT=

# Basemap tiles (default: OSM standard tiles; OSMF policy forbids heavy/commercial use)
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_TILE_ATTRIBUTION=

# Supabase (user profile + attraction feedback persistence)
# Project Settings → API in the Supabase dashboard (https://supabase.com/dashboard)
# Both are safe to expose in the browser — row-level security is what protects
# the data, see supabase/migrations/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Imagery "detected" tier (satellite land-cover finds, with mandatory warnings).
# 0 = off (default, keep OFF in production until Ariel's launch gate is green);
# 1 = on. Safety zones in src/lib/places/safety-zones.ts must be human-reviewed first.
NEXT_PUBLIC_DETECTED_TIER=0
